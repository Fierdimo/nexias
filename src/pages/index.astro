---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import WhyNow from "../components/WhyNow.astro";
import Services from "../components/Services.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Results from "../components/Results.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  lang="es"
  title="Nexia — Consultoría de IA y Automatización para Empresas Colombianas"
  description="Automatizamos procesos, construimos dashboards inteligentes y desplegamos agentes de IA. Consultoría de IA y automatización para negocios colombianos. Resultados medibles desde las primeras semanas."
>
  <Header lang="es" />
  <main>
    <Hero lang="es" />
    <WhyNow lang="es" />
    <Services lang="es" />
    <HowItWorks lang="es" />
    <Results lang="es" />
    <FAQ lang="es" />
    <FinalCTA lang="es" />
  </main>
  <Footer lang="es" />
</Layout>

<script>
  // Global ScrollTrigger reveal for all .reveal-section elements
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReduced && typeof gsap !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);
    document.querySelectorAll<HTMLElement>(".reveal-section").forEach((el) => {
      gsap.set(el, { opacity: 0, y: 60 });
      gsap.to(el, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el,
          start: "top 85%",
          toggleActions: "play none none none",
          once: true,
        },
      });
    });
  }
</script>
