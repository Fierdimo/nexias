---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { breadcrumbs } from "../../lib/schema";

const sugerencias = [
  "¿Cuál es el plato del día?",
  "¿Tienen bandeja paisa?",
  "Quiero hacer una reserva para 4 personas",
  "¿A qué hora cierran el sábado?",
  "¿Cuáles son las opciones vegetarianas?",
];
---

<Layout
  lang="es"
  title="Prueba un Chatbot con IA Gratis y sin Registro | Nexias"
  description="Escríbele ahora mismo a un chatbot con inteligencia artificial: responde el menú, los precios y los horarios de La Mesa, un restaurante ficticio. Demo en vivo, sin registro."
  schema={[breadcrumbs([{ name: "Inicio", path: "/" }, { name: "Demos", path: "/demos/" }, { name: "Asistente de IA", path: "/demos/asistente-ia/" }])]}
>
  <Header lang="es" currentPath="/demos/asistente-ia" />
  <main class="lg:min-h-screen lg:pt-24 lg:pb-20">
    <!-- Marco de la página: solo escritorio.
         En móvil el chat ocupa la pantalla entera, así que migas, titular y
         barra lateral desaparecen — competían por el espacio con lo único
         que la persona vino a hacer. -->
    <div class="hidden lg:block max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <nav class="flex items-center gap-2 text-xs text-[var(--color-muted)] font-body" aria-label="Breadcrumb">
        <a href="/demos/" class="hover:text-[var(--color-accent)] transition-colors">Demos</a>
        <span>›</span>
        <span class="text-[var(--color-text)]">Asistente de IA</span>
      </nav>
    </div>

    <div class="hidden lg:block max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 pb-8">
      <p class="text-xs font-body font-medium tracking-[0.2em] uppercase text-[var(--color-accent)] mb-2">Demo — Agentes de IA</p>
      <h1 class="font-display font-800 text-3xl sm:text-4xl text-[var(--color-text)] leading-tight mb-2">
        Asistente de <span class="text-gradient">La Mesa</span>
      </h1>
      <p class="text-sm text-[var(--color-muted)] font-body">
        Restaurante ficticio · Responde con la información real del negocio, en tiempo real
      </p>
    </div>

    <div class="lg:max-w-5xl lg:mx-auto lg:px-4 lg:px-8">
      <div class="lg:grid lg:grid-cols-3 lg:gap-6">

        <!-- Barra lateral: escritorio -->
        <div class="hidden lg:block space-y-4">
          <div class="border border-[var(--color-border)] rounded-xl p-5 bg-[var(--color-surface)]">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-full bg-[var(--color-accent)] flex items-center justify-center flex-shrink-0 text-white font-display font-800">LM</div>
              <div>
                <p class="font-display font-700 text-sm text-[var(--color-text)]">Asistente La Mesa</p>
                <div class="flex items-center gap-1.5 mt-0.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  <span class="text-xs text-emerald-600 font-body">En línea</span>
                </div>
              </div>
            </div>
            <div class="space-y-2 text-xs text-[var(--color-muted)] font-body">
              <p>📍 Carrera 13 #93-40, Bogotá</p>
              <p>🕐 Lun–Vie 12pm–10pm · Sáb–Dom 11am–11pm</p>
              <p>📞 +57 1 234 5678</p>
            </div>
          </div>

          <div class="border border-[var(--color-border)] rounded-xl p-5 bg-[var(--color-surface)]">
            <p class="text-xs font-body font-medium text-[var(--color-text)] mb-3">Preguntas sugeridas</p>
            <div class="space-y-2">
              {sugerencias.map((s) => (
                <button
                  class="suggestion-btn w-full text-left text-xs text-[var(--color-muted)] hover:text-[var(--color-accent)] border border-[var(--color-border)] hover:border-[var(--color-accent)]/40 rounded-lg px-3 py-2 transition-all font-body"
                  data-text={s}
                >
                  {s}
                </button>
              ))}
            </div>
          </div>

          <p class="text-xs text-[var(--color-muted)] font-body text-center px-2">
            Demo limitado a 10 mensajes por sesión. En producción se configura según tus necesidades.
          </p>
        </div>

        <!-- El chat.
             En móvil: panel fijo a pantalla completa, con su propia cabecera,
             como una app de mensajería. En lg vuelve a ser una tarjeta dentro
             de la página, que en escritorio sí funcionaba bien. -->
        <div
          id="chat-panel"
          class="fixed inset-0 z-50 flex flex-col bg-[var(--color-bg)]
                 lg:static lg:z-auto lg:col-span-2 lg:h-[580px] lg:bg-transparent"
        >
          <!-- Cabecera tipo app: solo móvil -->
          <header class="lg:hidden flex items-center gap-3 px-4 py-3 bg-[var(--color-accent)] text-white flex-shrink-0">
            <a href="/demos/" id="chat-back" class="-ml-1 p-1 rounded-full hover:bg-white/15 transition-colors" aria-label="Volver">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5M12 19l-7-7 7-7"/>
              </svg>
            </a>
            <div class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center flex-shrink-0 font-display font-800 text-sm">LM</div>
            <div class="min-w-0">
              <p class="font-display font-700 text-sm leading-tight truncate">Asistente La Mesa</p>
              <div class="flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-300 animate-pulse"></span>
                <span class="text-[13px] opacity-90 font-body">En línea</span>
              </div>
            </div>
          </header>

          <div class="flex-1 overflow-y-auto bg-[var(--color-surface)] p-4 space-y-4 lg:border lg:border-[var(--color-border)] lg:rounded-t-xl" id="chat-messages">
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-[var(--color-accent)] flex items-center justify-center flex-shrink-0 mt-0.5 text-white text-[12px] font-display font-800">LM</div>
              <div class="max-w-[85%]">
                <div class="bg-[var(--color-bg)] border border-[var(--color-border)] rounded-2xl rounded-tl-sm px-4 py-3 text-sm text-[var(--color-text)] font-body leading-relaxed">
                  ¡Bienvenido/a a <strong>La Mesa</strong>! 🍽️ Soy el asistente virtual del restaurante. Puedo ayudarte con el menú, horarios y reservas. ¿En qué te puedo servir?
                </div>
                <p class="text-[12px] text-[var(--color-muted)] mt-1 ml-1 font-body">Asistente · ahora</p>
              </div>
            </div>
          </div>

          <!-- Sugerencias como fichas deslizables: solo móvil.
               En la barra lateral quedaban fuera de la pantalla del chat. -->
          <div class="lg:hidden flex-shrink-0 bg-[var(--color-surface)] border-t border-[var(--color-border)] px-3 py-2.5 overflow-x-auto">
            <div class="flex gap-2 w-max">
              {sugerencias.map((s) => (
                <button
                  class="suggestion-btn whitespace-nowrap text-xs text-[var(--color-accent)] bg-[var(--color-accent-soft)] border border-[var(--color-accent)]/30 rounded-full px-3.5 py-2 font-body active:scale-95 transition-transform"
                  data-text={s}
                >
                  {s}
                </button>
              ))}
            </div>
          </div>

          <div class="flex-shrink-0 bg-[var(--color-surface)] border-t border-[var(--color-border)] p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] lg:border lg:border-t-0 lg:rounded-b-xl lg:pb-3">
            <div id="messages-limit" class="hidden text-center text-xs text-[var(--color-accent2)] font-body mb-2 py-1.5 bg-[var(--color-accent2)]/8 rounded-lg border border-[var(--color-accent2)]/25">
              Límite de demo alcanzado. <a href="/#contacto" class="underline">Contacta a Nexias</a> para implementarlo en tu negocio.
            </div>
            <form id="chat-form" class="flex gap-2" autocomplete="off">
              <input
                id="chat-input"
                type="text"
                placeholder="Escribe tu mensaje..."
                maxlength="300"
                class="flex-1 min-w-0 bg-[var(--color-bg)] border border-[var(--color-border)] rounded-full px-4 py-3 text-base lg:text-sm lg:rounded-xl lg:py-2.5 text-[var(--color-text)] placeholder:text-[var(--color-muted)] focus:outline-none focus:border-[var(--color-accent)] font-body transition-colors"
                aria-label="Mensaje"
              />
              <button
                type="submit"
                id="send-btn"
                class="w-11 h-11 lg:w-10 lg:h-10 rounded-full lg:rounded-xl bg-[var(--color-accent)] flex items-center justify-center transition-all hover:brightness-110 disabled:opacity-50 disabled:cursor-not-allowed flex-shrink-0"
                aria-label="Enviar"
              >
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <path d="M2 8h12M10 4l4 4-4 4" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </form>
          </div>
        </div>

      </div>
    </div>
  </main>

  <script is:inline>
    /*
     * El botón de atrás vuelve por donde se llegó, no a un destino fijo.
     *
     * Estaba clavado en /demos/, así que quien entraba desde la portada con
     * "Prueba el chat ahora" acababa en una página que nunca había visto. En
     * una cabecera que imita a una app de mensajería, esa flecha promete
     * deshacer el último paso.
     *
     * El href se conserva como destino real: es lo que usa quien abre en una
     * pestaña nueva, y lo que queda si alguien llega directo desde un enlace
     * compartido, cuando no hay historial al que volver.
     */
    document.getElementById("chat-back")?.addEventListener("click", (e) => {
      if (window.history.length > 1 && document.referrer.startsWith(window.location.origin)) {
        e.preventDefault();
        window.history.back();
      }
    });
  </script>

  <style is:global>
    /*
     * En móvil el chat es la pantalla, no un elemento dentro de ella.
     *
     * La barra de navegación del sitio, el pie y el botón flotante de WhatsApp
     * competían con él: el flotante se montaba justo encima del campo de
     * texto. Y sin bloquear el scroll del body, el panel fijo se sentía
     * "suelto" al arrastrar.
     */
    @media (max-width: 1023px) {
      #main-header { display: none; }
      footer { display: none; }
      body { overflow: hidden; }

      /* dvh descuenta la barra del navegador y el teclado; vh no. El primero
         es el que hace que el campo de texto no quede tapado al escribir, y
         el segundo está de respaldo para navegadores que no lo entiendan. */
      #chat-panel {
        height: 100vh;
        height: 100dvh;
      }
    }
  </style>
  <Footer lang="es" />
</Layout>

<script>
  const form       = document.getElementById("chat-form")      as HTMLFormElement;
  const input      = document.getElementById("chat-input")     as HTMLInputElement;
  const sendBtn    = document.getElementById("send-btn")       as HTMLButtonElement;
  const messages   = document.getElementById("chat-messages")! as HTMLDivElement;
  const limitBanner = document.getElementById("messages-limit")! as HTMLDivElement;

  interface Message { role: "user" | "assistant"; content: string; }
  const history: Message[] = [];
  let msgCount   = 0;
  const MAX_MSGS = 10;
  let isStreaming = false;

  function now(): string {
    return new Date().toLocaleTimeString("es-CO", { hour: "2-digit", minute: "2-digit" });
  }

  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight;
  }

  function appendUserMessage(text: string) {
    const div = document.createElement("div");
    div.className = "flex items-end justify-end gap-2";
    div.innerHTML = `
      <div class="max-w-[80%]">
        <div class="bg-[var(--color-accent)] rounded-2xl rounded-br-sm px-4 py-3 text-sm text-white font-body leading-relaxed">${escapeHtml(text)}</div>
        <p class="text-[12px] text-[var(--color-muted)] mt-1 mr-1 text-right font-body">Tú · ${now()}</p>
      </div>`;
    messages.appendChild(div);
    scrollToBottom();
  }

  function appendBotMessage(): HTMLElement {
    const wrapper = document.createElement("div");
    wrapper.className = "flex items-start gap-3";
    wrapper.innerHTML = `
      <div class="w-7 h-7 rounded-full bg-emerald-400/15 flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="#34D399" stroke-width="1.2"/><path d="M4 7a.7.7 0 101.4 0A.7.7 0 004 7zm4 0a.7.7 0 101.4 0A.7.7 0 008 7z" fill="#34D399"/><path d="M4.5 9.5c.6 1 4.4 1 5 0" stroke="#34D399" stroke-width="1.2" stroke-linecap="round"/></svg>
      </div>
      <div class="max-w-[85%]">
        <div class="bg-[var(--color-bg)] border border-[var(--color-border)] rounded-2xl rounded-tl-sm px-4 py-3 text-sm text-[var(--color-text)] font-body leading-relaxed bot-text">
          <span class="typing-cursor inline-block w-1 h-3.5 bg-emerald-400 rounded-sm ml-0.5 animate-pulse"></span>
        </div>
        <p class="text-[12px] text-[var(--color-muted)] mt-1 ml-1 font-body">Asistente · ${now()}</p>
      </div>`;
    messages.appendChild(wrapper);
    scrollToBottom();
    return wrapper.querySelector(".bot-text")!;
  }

  function appendTypingIndicator(): HTMLElement {
    const div = document.createElement("div");
    div.className = "flex items-start gap-3 typing-indicator";
    div.innerHTML = `
      <div class="w-7 h-7 rounded-full bg-emerald-400/15 flex items-center justify-center flex-shrink-0 mt-0.5">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="6" stroke="#34D399" stroke-width="1.2"/></svg>
      </div>
      <div class="bg-[var(--color-bg)] border border-[var(--color-border)] rounded-2xl rounded-tl-sm px-4 py-3 flex gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-muted)] animate-bounce" style="animation-delay:0ms"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-muted)] animate-bounce" style="animation-delay:150ms"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-muted)] animate-bounce" style="animation-delay:300ms"></span>
      </div>`;
    messages.appendChild(div);
    scrollToBottom();
    return div;
  }

  function escapeHtml(s: string): string {
    return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
  }

  function setDisabled(disabled: boolean) {
    input.disabled   = disabled;
    sendBtn.disabled = disabled;
    isStreaming      = disabled;
  }

  async function sendMessage(text: string) {
    if (!text.trim() || isStreaming || msgCount >= MAX_MSGS) return;

    msgCount++;
    if (msgCount >= MAX_MSGS) {
      limitBanner.classList.remove("hidden");
    }

    history.push({ role: "user", content: text });
    appendUserMessage(text);
    input.value = "";

    setDisabled(true);
    const indicator = appendTypingIndicator();

    try {
      const response = await fetch("/api/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages: history }),
      });

      indicator.remove();

      if (!response.ok) {
        const err = await response.json().catch(() => ({ error: "Error desconocido." }));
        const botEl = appendBotMessage();
        botEl.querySelector(".typing-cursor")?.remove();
        botEl.textContent = (err as { error?: string }).error ?? "Error al conectar.";
        setDisabled(false);
        return;
      }

      const botEl = appendBotMessage();
      const cursor = botEl.querySelector(".typing-cursor");
      let accumulated = "";

      const reader = response.body!.getReader();
      const decoder = new TextDecoder();

      while (true) {
        const { done, value } = await reader.read();
        if (done) break;

        const chunk = decoder.decode(value, { stream: true });
        const lines  = chunk.split("\n");

        for (const line of lines) {
          if (!line.startsWith("data: ")) {
            if (line.trim()) console.debug("[chat] raw non-data line:", JSON.stringify(line));
            continue;
          }
          const data = line.slice(6).trim();
          if (data === "[DONE]") { console.debug("[chat] [DONE] received, accumulated length:", accumulated.length); continue; }
          try {
            const parsed = JSON.parse(data);
            const delta  = parsed?.choices?.[0]?.delta?.content;
            if (typeof delta === "string") {
              accumulated += delta;
              // Render the text (cursor stays at end)
              botEl.textContent = accumulated;
              if (cursor) botEl.appendChild(cursor);
              scrollToBottom();
            } else {
              console.debug("[chat] chunk without content delta:", JSON.stringify(parsed));
            }
          } catch {
            console.debug("[chat] malformed JSON line:", JSON.stringify(line));
          }
        }
      }

      cursor?.remove();
      if (accumulated.trim()) {
        history.push({ role: "assistant", content: accumulated });
      } else {
        // Empty response: show a graceful fallback instead of blank bubble
        const fallback = "Disculpa, no pude procesar esa respuesta. ¿Puedes reformular tu pregunta?";
        botEl.textContent = fallback;
        // Remove last user message so history stays valid for next turn
        history.pop();
        scrollToBottom();
      }
    } catch (err) {
      indicator.remove();
      const botEl = appendBotMessage();
      botEl.querySelector(".typing-cursor")?.remove();
      botEl.textContent = "Error de conexión. Inténtalo de nuevo.";
    } finally {
      setDisabled(false);
      if (msgCount < MAX_MSGS) input.focus();
    }
  }

  // Form submit
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    sendMessage(input.value.trim());
  });

  // Suggestion buttons
  document.querySelectorAll<HTMLButtonElement>(".suggestion-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (isStreaming || msgCount >= MAX_MSGS) return;
      sendMessage(btn.dataset.text!);
    });
  });
</script>
