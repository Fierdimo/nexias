---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import SlideStage from "../../components/SlideStage.astro";
import FAQ from "../../components/FAQ.astro";
import FinalCTA from "../../components/FinalCTA.astro";
import Footer from "../../components/Footer.astro";
import { organization, webSite, faqPage } from "../../lib/schema";

const description =
  "AI agents and chatbots for businesses in Colombia and Latin America: they answer WhatsApp and phone calls 24/7, reply with your own business information and book appointments. Free 30-minute assessment.";
---

<Layout
  lang="en"
  title="AI Agents & Chatbots for Business in Colombia | Nexias"
  description={description}
  canonicalURL={new URL("/en/", Astro.site).href}
  alternates={{ es: "/", en: "/en/" }}
  schema={[organization("en", description), webSite("en"), faqPage("en")]}
>
  <Header lang="en" />
  <main>
    <SlideStage lang="en">
      <div class="slides__slide slides__slide--full" data-slide slot="first">
        <Hero lang="en" />
      </div>
      <div class="slides__slide slides__slide--wide" data-slide>
        <FAQ lang="en" />
      </div>
      <div class="slides__slide slides__slide--wide" data-slide>
        <FinalCTA lang="en" />
      </div>
    </SlideStage>
  </main>
  <Footer lang="en" />
</Layout>

