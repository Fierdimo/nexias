---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";
import HeroCanvas from "./HeroCanvas";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative flex items-center pt-24 pb-12 sm:pt-32 sm:pb-20 lg:pt-36 lg:pb-24 overflow-hidden bg-grid-blueprint" id="inicio">
  <!-- Glow blobs -->
  <div
    class="absolute top-[-10%] right-[-5%] w-[600px] h-[600px] rounded-full opacity-60 animate-blob-float pointer-events-none"
    style="background: radial-gradient(circle, rgba(8,97,111,0.10) 0%, transparent 70%); filter: blur(60px);"
    aria-hidden="true"
  ></div>

  <!--
    Fondo 3D. Decorativo, así que va aria-hidden y sin capturar el puntero:
    los CTAs quedan por encima y siguen siendo clicables. El degradado de
    máscara lo desvanece por la izquierda para que nunca compita con el
    titular, y `hidden lg:block` lo deja fuera de móvil.
  -->
  <div
    class="hidden lg:block absolute inset-y-0 right-0 w-[54%] pointer-events-none select-none opacity-[0.5]"
    style="mask-image: linear-gradient(to right, transparent 0%, black 32%); -webkit-mask-image: linear-gradient(to right, transparent 0%, black 32%);"
    aria-hidden="true"
  >
    <!--
      client:media y no client:idle: así el runtime de React (182 KB) tampoco
      se descarga en móvil, donde el efecto no se muestra. HeroCanvas no
      importa three arriba del todo — lo carga en diferido — así que se puede
      renderizar en servidor sin romper el build.
    -->
    <HeroCanvas client:media="(min-width: 1024px)" />
  </div>
  <div
    class="absolute bottom-[-5%] left-[-10%] w-[500px] h-[500px] rounded-full opacity-60 pointer-events-none"
    style="background: radial-gradient(circle, rgba(154,74,22,0.09) 0%, transparent 70%); filter: blur(80px); animation: blob-float 10s ease-in-out infinite reverse;"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="max-w-5xl">
      <!-- Eyebrow label -->
      <div class="hero-item inline-flex items-center gap-2 mb-6 px-3 py-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-surface)]/60">
        <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-accent)] animate-pulse" aria-hidden="true"></span>
        <span class="text-xs text-[var(--color-muted)] font-body tracking-wide">
          {lang === "es" ? "Agentes de IA y automatización" : "AI agents and automation"}
        </span>
      </div>

      <!-- Main headline -->
      <h1 class="hero-item font-display font-800 text-4xl sm:text-5xl lg:text-[3.4rem] leading-[1.08] tracking-tight mb-6">
        <span class="text-[var(--color-accent)]">{t.hero.headlineA}</span>
        <br />
        <span class="text-[var(--color-text)]">{t.hero.headlineB}</span>
      </h1>

      <!-- Subheadline -->
      <p class="hero-item text-lg sm:text-xl text-[var(--color-muted)] max-w-2xl leading-relaxed mb-10">
        {t.hero.sub}
      </p>

      <!-- CTAs -->
      <div class="hero-item flex flex-col sm:flex-row items-start sm:items-center gap-4 mb-16">
        <a href="#contacto" class="btn-primary font-medium text-base">
          {t.hero.ctaPrimary}
        </a>
        <a href="/demos/asistente-ia/" class="btn-secondary text-base">
          {t.hero.ctaSecondary} →
        </a>
      </div>

      <!-- Social proof numbers -->
      <div class="hero-item grid grid-cols-3 gap-3 sm:flex sm:flex-wrap sm:gap-12">
        {[
          { value: t.hero.proof1Value, label: t.hero.proof1Label },
          { value: t.hero.proof2Value, label: t.hero.proof2Label },
          { value: t.hero.proof3Value, label: t.hero.proof3Label },
        ].map(({ value, label }) => (
          <div class="flex flex-col">
            <span class="font-display font-800 text-sm sm:text-2xl whitespace-nowrap text-[var(--color-accent)]">{value}</span>
            <span class="text-[13px] leading-snug sm:text-sm text-[var(--color-muted)] sm:max-w-[16ch]">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Bottom fade -->
  <div class="absolute bottom-0 left-0 right-0 h-32 pointer-events-none" style="background: linear-gradient(to top, var(--color-bg), transparent);" aria-hidden="true"></div>
</section>
