---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const waLink = "https://wa.me/573028308008?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20Nexias";
---

<footer class="relative border-t border-[var(--color-border)] bg-[var(--color-surface)] mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center gap-2 mb-4">
          <svg width="28" height="28" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="7" fill="#0D1526"/>
            <path d="M8 24V8h3.2l9.6 11.2V8H24v16h-3.2L11.2 12.8V24H8z" fill="#E8EDF5"/>
            <path d="M11.2 8l9.6 11.2" stroke="#00D4FF" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <span class="font-display font-700 text-lg text-[var(--color-text)]">Nexias</span>
        </div>
        <p class="text-[var(--color-muted)] text-sm leading-relaxed max-w-xs">
          {t.footer.tagline}
        </p>
        <!-- Social links -->
        <div class="flex items-center gap-3 mt-6">
          <a
            href="https://www.linkedin.com/in/gregorio-morales-pajaro/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-accent)] hover:border-[var(--color-accent)]/40 transition-all"
            aria-label="LinkedIn de Gregorio Morales, fundador de Nexias"
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
          </a>
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 flex items-center justify-center rounded-lg border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[#25D366] hover:border-[#25D366]/40 transition-all"
            aria-label={t.footer.whatsapp}
          >
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services links -->
      <div>
        <h3 class="font-display text-sm font-700 text-[var(--color-text)] mb-4 uppercase tracking-wider">{t.footer.services}</h3>
        <ul class="space-y-3 list-none">
          {[
            { label: "Diagnóstico", href: "/servicios/diagnostico-datos-procesos/" },
            { label: "Analítica BI", href: "/servicios/analitica-datos-dashboards-bi/" },
            { label: "Automatización RPA", href: "/servicios/automatizacion-procesos-rpa/" },
            { label: "Agentes de IA", href: "/servicios/agentes-ia-whatsapp/" },
            { label: "Acompañamiento", href: "/servicios/" },
          ].map(({ label, href }) => (
            <li>
              {/* Las páginas de servicio solo existen en español; en inglés se
                  cae al ancla de la home en vez de enlazar a un 404. */}
              <a
                href={lang === "es" ? href : "#servicios"}
                class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h3 class="font-display text-sm font-700 text-[var(--color-text)] mb-4 uppercase tracking-wider">{t.footer.legal}</h3>
        <ul class="space-y-3 list-none">
          <li>
            <a href="#" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">{t.footer.privacy}</a>
          </li>
          <li>
            <a href="#" class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors">{t.footer.terms}</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-[var(--color-border)] pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-[var(--color-muted)]">
        © {year} Nexias. {t.footer.rights}
      </p>
      <p class="text-xs text-[var(--color-muted)]">
        Colombia 🇨🇴
      </p>
    </div>
  </div>

  <!-- WhatsApp floating button -->
  <a
    href={waLink}
    target="_blank"
    rel="noopener noreferrer"
    class="fixed bottom-6 right-6 z-50 w-14 h-14 flex items-center justify-center rounded-full bg-[#25D366] shadow-lg hover:scale-110 transition-transform"
    aria-label={t.footer.whatsapp}
  >
    <svg width="28" height="28" fill="white" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
    </svg>
  </a>
</footer>
