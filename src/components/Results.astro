---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="reveal-section py-16 sm:py-24 relative bg-[var(--color-surface)]" id="resultados">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-xs text-[var(--color-accent)] font-body uppercase tracking-widest mb-4">{t.results.label}</span>
      <h2 class="font-display font-800 text-3xl sm:text-4xl lg:text-5xl text-[var(--color-text)] max-w-3xl mx-auto leading-tight">
        {t.results.heading}
      </h2>
      <p class="mt-4 text-base text-[var(--color-muted)] max-w-2xl mx-auto leading-relaxed">
        {t.results.sub}
      </p>
    </div>

    <!-- Las dos formas de probarlo. El chat va primero y sin fricción
         porque no cuesta nada; la llamada pide cita porque cada minuto
         de teléfono se paga, y así el interés queda calificado. -->
    <div class="grid gap-5 md:grid-cols-2 max-w-4xl mx-auto mb-16">
      {t.results.demos.map((d) => (
        <div class={`rounded-2xl p-7 flex flex-col border ${d.instant
          ? "border-[var(--color-accent)] bg-[var(--color-accent-soft)]"
          : "border-[var(--color-border)] bg-[var(--color-bg)]"}`}>
          <span class={`self-start inline-flex items-center gap-1.5 px-3 py-1 mb-4 text-xs font-medium rounded-full ${d.instant
            ? "bg-[var(--color-accent)] text-[var(--color-on-accent)]"
            : "bg-[var(--color-accent2)]/12 text-[var(--color-accent2)] border border-[var(--color-accent2)]/25"}`}>
            {d.instant && <span class="w-1.5 h-1.5 rounded-full bg-current animate-pulse" aria-hidden="true"></span>}
            {d.badge}
          </span>
          <h3 class="font-display font-700 text-xl text-[var(--color-text)] mb-2">{d.title}</h3>
          <p class="text-sm text-[var(--color-muted)] leading-relaxed flex-1">{d.body}</p>
          <a
            href={d.href}
            {...(d.href.startsWith("http") ? { target: "_blank", rel: "noopener" } : {})}
            class={`mt-6 self-start ${d.instant ? "btn-primary" : "btn-secondary"} text-sm py-2.5 px-5`}
          >
            {d.cta} →
          </a>
        </div>
      ))}
    </div>

    <!-- Metrics -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-20">
      {t.results.metrics.map((m) => (
        <div class="flex flex-col items-center text-center p-6 rounded-2xl border border-[var(--color-border)] bg-[var(--color-bg)]">
          <div class="flex items-end gap-1 mb-2">
            <span
              class="font-display font-800 text-4xl text-[var(--color-accent)] counter"
              data-target={m.value}
              aria-label={`${m.value}${m.suffix} ${m.label}`}
            >{String(m.value)}</span>
            <span class="font-display font-700 text-2xl text-[var(--color-accent)] pb-1">{m.suffix}</span>
          </div>
          <span class="text-sm text-[var(--color-muted)]">{m.label}</span>
        </div>
      ))}
    </div>

    <!-- Case studies -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {t.results.cases.map((c) => (
        <article class="border-glow rounded-2xl p-8 bg-[var(--color-bg)] flex flex-col gap-4">
          <span class="inline-block text-xs px-3 py-1 rounded-full bg-[var(--color-accent)]/10 text-[var(--color-accent)] border border-[var(--color-accent)]/20 self-start">
            {c.sector}
          </span>
          <h3 class="font-display font-700 text-lg text-[var(--color-text)] leading-snug">{c.title}</h3>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed">{c.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  /*
   * Los contadores nacen con su valor real en el HTML, no en cero.
   *
   * Antes el marcado traía un 0 literal y solo GSAP lo convertía en el número
   * bueno. GSAP llega por CDN: si tardaba, si un bloqueador lo cortaba o si
   * ScrollTrigger no disparaba, el visitante leía que atendemos "0/7" y que se
   * transcribe el "0%" de las llamadas. Un dato equivocado es peor que ninguno.
   *
   * Ahora el cero lo pone el propio script, y solo en el instante previo a
   * animar — cuando ya está garantizado que algo lo va a devolver a su sitio.
   */
  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReduced && typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
    gsap.registerPlugin(ScrollTrigger);

    document.querySelectorAll<HTMLElement>(".counter").forEach((el) => {
      const target = parseInt(el.dataset.target ?? "0", 10);
      const obj = { val: 0 };
      gsap.to(obj, {
        val: target,
        duration: 2,
        ease: "power1.out",
        onStart() {
          el.textContent = "0";
        },
        onUpdate() {
          el.textContent = String(Math.round(obj.val));
        },
        onComplete() {
          el.textContent = String(target);
        },
        scrollTrigger: {
          trigger: el,
          start: "top 80%",
          once: true,
        },
      });
    });
  }
</script>
