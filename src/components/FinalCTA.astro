---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const waLink = "https://wa.me/573000000000?text=Hola%2C%20quiero%20agendar%20mi%20diagn%C3%B3stico%20gratuito%20con%20Nexia";
---

<section class="reveal-section py-24 relative" id="contacto">
  <!-- Background glow -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden" aria-hidden="true">
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] rounded-full opacity-15"
      style="background: radial-gradient(ellipse, rgba(0,212,255,0.4) 0%, transparent 70%); filter: blur(60px);">
    </div>
  </div>

  <div class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <span class="inline-block text-xs text-[var(--color-accent)] font-body uppercase tracking-widest mb-4">{t.contact.label}</span>
      <h2 class="font-display font-800 text-3xl sm:text-4xl text-[var(--color-text)] leading-tight mb-4">
        {t.contact.heading}
      </h2>
      <p class="text-[var(--color-muted)] leading-relaxed">
        {t.contact.sub}
      </p>
    </div>

    <!-- Form -->
    <form
      id="contact-form"
      action={import.meta.env.PUBLIC_FORM_ENDPOINT ?? "https://formspree.io/f/placeholder"}
      method="POST"
      class="flex flex-col gap-4 border border-[var(--color-border)] rounded-2xl bg-[var(--color-surface)] p-8"
      novalidate
    >
      <input
        type="text"
        name="name"
        placeholder={t.contact.namePlaceholder}
        required
        autocomplete="name"
        class="w-full px-4 py-3 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] text-sm focus:outline-none focus:border-[var(--color-accent)]/60 transition-colors"
      />
      <input
        type="text"
        name="company"
        placeholder={t.contact.companyPlaceholder}
        required
        class="w-full px-4 py-3 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] text-sm focus:outline-none focus:border-[var(--color-accent)]/60 transition-colors"
      />
      <input
        type="tel"
        name="whatsapp"
        placeholder={t.contact.whatsappPlaceholder}
        required
        autocomplete="tel"
        class="w-full px-4 py-3 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] placeholder:text-[var(--color-muted)] text-sm focus:outline-none focus:border-[var(--color-accent)]/60 transition-colors"
      />
      <select
        name="sector"
        required
        class="w-full px-4 py-3 rounded-lg bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-text)] text-sm focus:outline-none focus:border-[var(--color-accent)]/60 transition-colors appearance-none"
      >
        <option value="" disabled selected>{t.contact.sectorLabel}</option>
        {t.contact.sectors.map((s) => (
          <option value={s}>{s}</option>
        ))}
      </select>

      <!-- Hidden honeypot (spam prevention) -->
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <button
        type="submit"
        class="btn-primary w-full justify-center text-base py-3.5 mt-2"
      >
        {t.contact.submit}
      </button>

      <!-- Success message (hidden initially) -->
      <div
        id="form-success"
        class="hidden text-center p-6 rounded-xl bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25"
        role="status"
        aria-live="polite"
      >
        <p class="font-display font-700 text-[var(--color-accent)] mb-1">{t.contact.successTitle}</p>
        <p class="text-sm text-[var(--color-muted)]">{t.contact.successBody}</p>
      </div>

      <!-- Error message (hidden initially) -->
      <div
        id="form-error"
        class="hidden text-center p-4 rounded-xl bg-red-500/10 border border-red-500/25"
        role="alert"
        aria-live="assertive"
      >
        <p class="text-sm text-red-400">
          {lang === "es" ? "Algo salió mal. Por favor, inténtalo de nuevo." : "Something went wrong. Please try again."}
        </p>
      </div>
    </form>

    <!-- WhatsApp alternative CTA -->
    <div class="text-center mt-6">
      <p class="text-sm text-[var(--color-muted)] mb-4">{lang === "es" ? "— o —" : "— or —"}</p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[#25D366] transition-colors"
      >
        <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {t.contact.altCTA}
      </a>
    </div>
  </div>
</section>

<script is:inline>
  const form = document.getElementById("contact-form");
  const successEl = document.getElementById("form-success");
  const errorEl = document.getElementById("form-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector("button[type=submit]");
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        form.querySelectorAll("input, select, button").forEach((el) => el.classList.add("hidden"));
        successEl?.classList.remove("hidden");
      } else {
        errorEl?.classList.remove("hidden");
        submitBtn.disabled = false;
      }
    } catch {
      errorEl?.classList.remove("hidden");
      submitBtn.disabled = false;
    }
  });
</script>
