---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const serviceIcons = [
  // Diagnosis / map
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>`,
  // Analytics / chart
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/><line x1="2" y1="20" x2="22" y2="20"/></svg>`,
  // RPA / automation
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  // AI agent / bot
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><line x1="12" y1="11" x2="12" y2="17"/><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/></svg>`,
  // Voice agent / phone
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`,
  // Continuous support / shield
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
];
---

<section class="reveal-section py-16 sm:py-24 relative" id="servicios">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16">
      <span class="inline-block text-xs text-[var(--color-accent)] font-body uppercase tracking-widest mb-4">{t.services.label}</span>
      <h2 class="font-display font-800 text-3xl sm:text-4xl lg:text-5xl text-[var(--color-text)] max-w-3xl mx-auto leading-tight mb-4">
        {t.services.heading}
      </h2>
      <p class="text-[var(--color-muted)] text-lg max-w-2xl mx-auto">
        {t.services.sub}
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {t.services.list.map((service, i) => (
        <article class="group relative border-glow rounded-2xl p-8 bg-[var(--color-surface)] flex flex-col gap-4 transition-all duration-300 hover:-translate-y-1">
          <!-- Icon -->
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-[var(--color-accent)]/10 text-[var(--color-accent)] group-hover:bg-[var(--color-accent)]/20 transition-colors" set:html={serviceIcons[i]} />

          <!-- Badges -->
          <div class="flex flex-wrap gap-2">
            {"badge" in service && service.badge && (
              <span class="inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-full bg-[var(--color-accent)]/15 text-[var(--color-accent)] border border-[var(--color-accent)]/25 font-medium">
                ⚡ {t.services.badge}
              </span>
            )}
            {"demo" in service && service.demo && (
              <a
                href={service.demo}
                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs rounded-full bg-[var(--color-accent2)]/15 text-[var(--color-accent2)] border border-[var(--color-accent2)]/25 hover:bg-[var(--color-accent2)]/25 transition-colors font-medium"
              >
                {t.services.demoBadge}
              </a>
            )}
          </div>

          <h3 class="font-display font-700 text-lg text-[var(--color-text)] leading-tight">{service.name}</h3>
          <p class="text-[var(--color-muted)] text-sm leading-relaxed flex-1">{service.desc}</p>

          {"page" in service && service.page && (
            <a
              href={service.page}
              class="text-sm font-body text-[var(--color-accent)] hover:underline mt-1"
            >
              {"linkLabel" in service && service.linkLabel ? service.linkLabel : "Ver servicio"} →
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
